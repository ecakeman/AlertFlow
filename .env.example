# Local development defaults. Copy to .env. Do not put a production password here.
POSTGRES_PASSWORD=alertflow

# Application database. The server reads ALERTFLOW_DATABASE_URL.
ALERTFLOW_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/alertflow?sslmode=disable

# Maintenance database used only by `go test`. Tests create and drop
# databases named alertflow_test_* and never drop the database named alertflow.
ALERTFLOW_TEST_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/postgres?sslmode=disable

# Kafka brokers. Host tests use the published EXTERNAL listener.
# Compose publisher and consumer use kafka:29092 instead.
ALERTFLOW_KAFKA_BROKERS=127.0.0.1:9092

# Read cache. Optional: leave empty and the API serves everything from
# PostgreSQL. Compose uses the service name; host runs use the published port.
REDIS_URL=redis://127.0.0.1:6379/0

# Bearer for GET /internal/agent/v1. Empty disables that group.
ALERTFLOW_AGENT_TOKEN=

# gRPC. These ports stay on the Compose network and are not published.
# ALERTFLOW_GRPC_ADDR=:9090
# Empty leaves incidents and timeline in place and creates no agent task.
# Set this when the agent profile is on. A set target that cannot be reached
# stays pending and is retried; it is not treated as the agent being off.
# ALERTFLOW_AGENT_GRPC_TARGET=agent:9000
# AGENT_GRPC_ADDR=:9000
# ALERTFLOW_GRPC_TARGET=alertflow:9090
# AGENT_TASK_GRPC_TOKEN=
# ALERTFLOW_AGENT_GRPC_TOKEN=

# Image overrides. Defaults are the official tags. Set one only after that
# registry pull or package download fails.
#
# POSTGRES_IMAGE must provide the pgvector extension: the agent schema declares
# `CREATE EXTENSION vector` and indexes an embedding column with hnsw. A plain
# postgres image will fail to start the agent.
# POSTGRES_IMAGE=pgvector/pgvector:pg16
# Behind a restricted network, point it at a mirror, e.g.:
# POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
# KAFKA_IMAGE=apache/kafka:3.9.1
# REDIS_IMAGE=redis:7-alpine
# NODE_IMAGE=node:22-alpine
# GO_IMAGE=golang:1.25
# RUNTIME_IMAGE=gcr.io/distroless/static:latest
# PYTHON_IMAGE=python:3.12-slim
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=
# GOPROXY=

# Bearer for POST /webhooks/agent (the Agent pushes its diagnosis back).
# Empty disables that endpoint.
ALERTFLOW_AGENT_CALLBACK_TOKEN=

# Agent process. These names match docker-compose.yml.
AGENT_WEBHOOK_TOKEN=
AGENT_API_TOKEN=
# Where the agent pushes results, and the bearer it uses (same value as the
# ALERTFLOW_AGENT_CALLBACK_TOKEN above).
AGENT_CALLBACK_URL=http://alertflow:8080/webhooks/agent
AGENT_CALLBACK_TOKEN=
AGENT_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/alertflow_agent?sslmode=disable
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DIAGNOSTICS_FILE=agent/diagnostics.example.yaml

# How AlertFlow reaches the Agent in-network (used by docker-compose.yml).
AGENT_BASE_URL=http://agent:8000

# --- 演示目标（compose profile "demo"）---
# Fault Lab 的控制台令牌，保护它的 /control/v1/* 接口。
SIMULATOR_CONTROL_TOKEN=dev-control-token
# Fault Lab 检出目录（相对本仓库）。两个仓库并排时用默认值即可。
FAULT_LAB_CONTEXT=../fault-lab
CHECK_LOOKBACK_MINUTES=60
CHECK_MAX_ROWS=500
# 入站信封上限（字节）。默认上下文比早期事件大得多，64 KiB 装不下。
WEBHOOK_MAX_BYTES=524288
# 每次 run 允许「回头找 AlertFlow 要数据」的次数（检查历史/指标/Incident 详情）。
MAX_QUERY_CALLS=8
MAX_LEAD_ROUNDS=8
MAX_LLM_CALLS=24
MAX_TOOL_CALLS=14
MAX_REPLANS=2
MAX_REVISIONS=2
MAX_SUBAGENT_RUNS=2
SUBAGENT_MAX_ROUNDS=4
MAX_TOTAL_TOKENS=150000
RUN_TIMEOUT_SECONDS=300
REPORT_GRACE_SECONDS=90
MAX_CONCURRENT_RUNS=2
AGENT_REVISE_ON_RESOLVE=false
AGENT_ENABLE_WARNING_RUNS=false
