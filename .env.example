# Local development defaults. Copy to .env. Do not put a production password here.
POSTGRES_PASSWORD=alertflow

# Application database. The server reads ALERTFLOW_DATABASE_URL.
ALERTFLOW_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/alertflow?sslmode=disable

# Maintenance database used only by `go test`. Tests create and drop
# databases named alertflow_test_* and never drop the database named alertflow.
ALERTFLOW_TEST_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/postgres?sslmode=disable

# Kafka brokers. Host tests use the published EXTERNAL listener.
# Compose publisher and consumer use kafka:29092 instead.
ALERTFLOW_KAFKA_BROKERS=127.0.0.1:9092

# Bearer for GET /internal/agent/v1. Empty disables that group.
ALERTFLOW_AGENT_TOKEN=

# Bearer for POST /api/alerts/webhook. Empty disables that endpoint.
ALERTFLOW_WEBHOOK_TOKEN=

# Agent process. These names match docker-compose.yml.
AGENT_WEBHOOK_TOKEN=
AGENT_API_TOKEN=
AGENT_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/alertflow_agent?sslmode=disable
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DIAGNOSTICS_FILE=agent/diagnostics.example.yaml
CHECK_LOOKBACK_MINUTES=60
CHECK_MAX_ROWS=500
MAX_LEAD_ROUNDS=8
MAX_LLM_CALLS=24
MAX_TOOL_CALLS=14
MAX_REPLANS=2
MAX_REVISIONS=2
MAX_SUBAGENT_RUNS=2
SUBAGENT_MAX_ROUNDS=4
MAX_TOTAL_TOKENS=150000
RUN_TIMEOUT_SECONDS=300
REPORT_GRACE_SECONDS=90
MAX_CONCURRENT_RUNS=2
AGENT_REVISE_ON_RESOLVE=false
AGENT_ENABLE_WARNING_RUNS=false
