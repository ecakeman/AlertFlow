# Local development defaults. Copy to .env. Do not put a production password here.
POSTGRES_PASSWORD=alertflow

# Application database. The server reads ALERTFLOW_DATABASE_URL.
ALERTFLOW_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/alertflow?sslmode=disable

# Maintenance database used only by `go test`. Tests create and drop
# databases named alertflow_test_* and never drop the database named alertflow.
ALERTFLOW_TEST_DATABASE_URL=postgres://alertflow:alertflow@127.0.0.1:5432/postgres?sslmode=disable
