# --- Local runtime config data (never commit) ---
/config/config.yaml
/config/*.db
/config/*.db-shm
/config/*.db-wal
/config/images/
/config/backups/

# Image archives from make package-images. Do not commit them.
/dist/*.tar

# --- Compiled binaries ---
/upmonitor
/alertflow
backend/upmonitor
backend/alertflow

# Local env (see .env.example)
.env

# --- Embedded web build (generated; keep only the placeholder) ---
backend/internal/web/dist/*
!backend/internal/web/dist/index.html

# --- Node / Vite ---
node_modules/
web-ui/dist/

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/

# --- OS / misc ---
.DS_Store
*.log

# Git / editor
.git
.gitignore
.github
.vscode
.idea
.claude
# --- 本地备份与运行产物（不入库）---
*.bak-*
.env.bak*
/data/
/ALERTFLOW_CURSOR_PLAN*.md
