AGENT_WEBHOOK_TOKEN=
AGENT_API_TOKEN=
ALERTFLOW_BASE_URL=http://alertflow:8080
ALERTFLOW_AGENT_TOKEN=
AGENT_DATABASE_URL=postgres://alertflow:alertflow@postgres:5432/alertflow_agent?sslmode=disable
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
AGENT_REVISE_ON_RESOLVE=false
AGENT_ENABLE_WARNING_RUNS=false
DIAGNOSTICS_FILE=/diagnostics/diagnostics.yaml
CHECK_LOOKBACK_MINUTES=60
CHECK_MAX_ROWS=500
MAX_LEAD_ROUNDS=8
MAX_LLM_CALLS=24
MAX_TOOL_CALLS=14
MAX_REPLANS=2
MAX_REVISIONS=2
MAX_SUBAGENT_RUNS=2
SUBAGENT_MAX_ROUNDS=4
MAX_TOTAL_TOKENS=150000
RUN_TIMEOUT_SECONDS=300
REPORT_GRACE_SECONDS=90
MAX_CONCURRENT_RUNS=2
