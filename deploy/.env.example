# AlertFlow 本地 Compose 环境变量模板
#
# 用法（在仓库根目录执行）：
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d --build
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build
#
# 说明：
# - 第 1 节变量写在 deploy/.env 中会被 Compose 读取并生效。
# - 第 2 节是容器内变量，Compose 已固定（或不使用 Compose 时的默认值），写在 .env 不会覆盖 Compose 内置值。
# - 必填 = 不设置则对应服务无法正常启动/功能不可用；选填 = 可以不设置。
# - 不要提交真实密码、模型 API Key 或 Token。

# ============ 1. Compose 变量（写入 deploy/.env 生效） ============

# 选填，默认 false：是否启用 Kubernetes Deployment / StatefulSet 监控。
# 本地 Compose 默认关闭，不需要本机 Kubernetes 集群或 kubeconfig。
ALERTFLOW_K8S_ENABLED=false
# 选填，默认 default：K8s 工作负载所在 namespace。由 Go Backend 统一配置，不按 target 存储。
ALERTFLOW_K8S_NAMESPACE=default

# 选填，默认 13000：Web 控制台宿主机端口（容器内 Nginx 监听 80）。
FRONTEND_PORT=13000

# 选填，默认 false：Main Agent 是否调用 Knowledge Agent 检索证据。
# 设为 true 时还需用 --profile knowledge 启动 Knowledge Agent。
ALERTFLOW_KNOWLEDGE_ENABLED=false
# 选填，默认空：Java Integration 与 Knowledge Agent 之间的 A2A Bearer Token。
# 为空时 Java 拒绝 A2A 调用；启用 Knowledge Agent 时必填。
KNOWLEDGE_A2A_TOKEN=
# 选填，默认 33554432（32MiB）：Knowledge Agent 单文件上传上限（字节）。
KNOWLEDGE_UPLOAD_MAX_BYTES=33554432
# 选填，默认 5：Knowledge Agent 摄取任务最大尝试次数。
KNOWLEDGE_INGEST_MAX_ATTEMPTS=5

# 选填，默认空：模型 API Key。为空时 Python Agent 使用 ScriptedModel，不调用真实模型，
# 诊断产物为固定脚本结果；要得到真实诊断必须填写。
ALERTFLOW_LLM_API_KEY=
# 选填，默认 https://api.openai.com/v1：OpenAI 兼容模型接口地址。
ALERTFLOW_LLM_BASE_URL=https://api.openai.com/v1
# 选填，默认 gpt-4o-mini：模型名称。
ALERTFLOW_LLM_MODEL=gpt-4o-mini

# ============ 2. 容器内变量（Compose 已固定，仅供非 Compose 运行参考） ============

# ---- Go Backend（Compose 服务名 alertflow，对外 18080:8080） ----
# 必填：PostgreSQL 连接串。Compose 固定为 postgres 网络地址。
ALERTFLOW_DATABASE_URL=postgres://alertflow:alertflow@postgres:5432/alertflow?sslmode=disable
# 选填，默认 :8080：HTTP 监听地址。
ALERTFLOW_HTTP_ADDR=:8080
# 选填，默认 :9090：gRPC 监听地址（仅 Compose 网络内）。
ALERTFLOW_GRPC_ADDR=:9090
# 选填，默认空：Kafka broker 列表（逗号分隔）。为空时不投递 Outbox 事件。
ALERTFLOW_KAFKA_BROKERS=kafka:9092
# 选填，默认 alertflow.agent-task-ready.v1：任务就绪事件 topic。
ALERTFLOW_KAFKA_TOPIC=alertflow.agent-task-ready.v1
# 选填，默认空：Redis 地址（Cache Aside）。为空时不用缓存。
ALERTFLOW_REDIS_URL=redis://redis:6379/0
# 选填，默认空：Go 访问 Java gRPC。为空时 Episode 产物接口返回 503 AGENT_UNAVAILABLE。
ALERTFLOW_AGENT_GRPC_TARGET=integration:9091

# ---- Java Integration（Compose 服务名 integration，内部 8081 HTTP / 9091 gRPC） ----
# 选填，默认空：HTTP 监听地址；非空时覆盖 server.port（取末段端口）。
INTEGRATION_HTTP_ADDR=:8081
# 选填，默认 8081：HTTP 端口（application.yaml 中 server.port）。
INTEGRATION_HTTP_PORT=8081
# 选填，默认 :9091：gRPC 监听地址。
INTEGRATION_GRPC_ADDR=:9091
# 选填，默认 127.0.0.1:9090：Java 转发到 Go gRPC。
INTEGRATION_GO_GRPC_TARGET=alertflow:9090
# 选填，默认 127.0.0.1:9000：Java 转发到 Python gRPC。
INTEGRATION_PYTHON_GRPC_TARGET=agent:9000
# 必填：gateway schema 的 PostgreSQL JDBC 连接串。
INTEGRATION_DATABASE_URL=jdbc:postgresql://postgres:5432/alertflow?currentSchema=gateway
# 必填：gateway schema 数据库用户（db-init 创建）。
INTEGRATION_DATABASE_USER=gateway_app
# 必填：gateway schema 数据库密码（db-init 创建）。
INTEGRATION_DATABASE_PASSWORD=gateway
# 选填，默认空：Nacos 地址；为空时不向 Nacos 发现 Knowledge Agent。
NACOS_SERVER_ADDR=nacos:8848
# 选填，默认空：Nacos 用户名（Nacos 开启鉴权时填写）。
NACOS_USERNAME=
# 选填，默认空：Nacos 密码。
NACOS_PASSWORD=
# 选填，默认空：静态 agent card，格式 agent-id=url，逗号分隔。
INTEGRATION_AGENT_CARDS=knowledge-agent=http://knowledge-agent:8000
# 选填，默认空：MCP 上游列表（agent-id=url，逗号分隔）。
INTEGRATION_MCP_UPSTREAMS=
# 选填，默认 main-agent-token：Main Agent 访问 MCP Gateway 的 Token。
ALERTFLOW_MAIN_MCP_TOKEN=main-agent-token
# 选填，默认 knowledge-agent-token：Knowledge Agent 访问 MCP Gateway 的 Token。
KNOWLEDGE_AGENT_MCP_TOKEN=knowledge-agent-token
# 选填，默认 300：Agent card 快照陈旧期（秒）。
INTEGRATION_REGISTRY_STALE_SECONDS=300
# 选填，默认 32：Java 远端调用并发上限。
INTEGRATION_MAX_INFLIGHT=32
# 选填，默认 -Xms128m -Xmx512m：JVM 参数。
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m

# ---- Python Main Agent（Compose 服务名 agent，内部 8000 HTTP / 9000 gRPC） ----
# 必填：PostgreSQL 连接串（与 Go 共库）。
ALERTFLOW_DATABASE_URL=postgres://alertflow:alertflow@postgres:5432/alertflow?sslmode=disable
# 选填，默认 127.0.0.1:9090：Python 访问 Java gRPC（再由 Java 转发 Go）。
ALERTFLOW_GRPC_TARGET=integration:9091
# 选填，默认 0.0.0.0:9000：gRPC 监听地址。
AGENT_GRPC_ADDR=0.0.0.0:9000
# 选填，默认 0.0.0.0:8000：FastAPI 监听地址。
AGENT_HTTP_ADDR=0.0.0.0:8000
# 选填，默认 4：并发执行任务数。
AGENT_MAX_CONCURRENT_TASKS=4
# 选填，默认 128：任务队列容量。
AGENT_TASK_QUEUE_CAPACITY=128
# 选填，默认 20：退出时等待执行中任务的秒数。
AGENT_SHUTDOWN_TIMEOUT=20
# 选填，默认空：Java MCP Gateway 地址；受 ALERTFLOW_KNOWLEDGE_ENABLED 控制。
ALERTFLOW_MCP_ENDPOINT=http://integration:8081/mcp
# 选填，默认 main-agent-token：访问 MCP Gateway 的 Token。
ALERTFLOW_MCP_TOKEN=main-agent-token
# 选填，默认 384：故障文档向量维度。
ALERTFLOW_EMBEDDING_DIM=384

# ---- 可选 Knowledge Agent（--profile knowledge 启动，独立仓库镜像） ----
# 必填：knowledge 库连接串。
DATABASE_URL=postgresql+psycopg://knowledge_app:knowledge@postgres:5432/knowledge
# 选填，默认 true（Compose 固定）：Knowledge Agent 服务模式。
KNOWLEDGE_AGENT_MODE=true
# 选填，默认 /data/knowledge：证据存储目录，挂载命名卷 knowledge-data。
KNOWLEDGE_STORAGE_ROOT=/data/knowledge
# 选填，默认空：Knowledge Agent 访问 MCP Gateway 的地址。
KNOWLEDGE_MCP_ENDPOINT=http://integration:8081/mcp
# 选填，默认 knowledge-agent-token：Knowledge Agent 访问 MCP Gateway 的 Token。
KNOWLEDGE_MCP_TOKEN=knowledge-agent-token
# 选填，默认 3：A2A 调用最大跳数。
KNOWLEDGE_MAX_HOPS=3

# ============ 3. 资源限制（Compose 内固定值，当前不通过 .env 覆盖） ============
# kafka: mem_limit 768m
# nacos: mem_limit 768m
# integration: mem_limit 768m（JAVA_TOOL_OPTIONS 默认 -Xms128m -Xmx512m）
# knowledge-agent: mem_limit 768m
# 其余服务（postgres、redis、fault、alertflow、frontend、agent、db-init）未设 mem_limit。
