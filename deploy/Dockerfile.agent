FROM python:3.12-slim-bookworm
WORKDIR /app
COPY .venv/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY src /app/src
ENV PYTHONPATH=/app/src \
    AGENT_HTTP_ADDR=0.0.0.0:8000
EXPOSE 9000 8000
HEALTHCHECK --interval=5s --timeout=3s --retries=20 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2)"
CMD ["python", "-m", "alertflow_agent"]
