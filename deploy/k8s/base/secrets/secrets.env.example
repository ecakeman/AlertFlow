# 本地 Secret 文件模板（**不要提交真实值**）。
#
# 真实文件默认位置：$HOME/.config/alertflow/k8s-secrets.env（0600，位于 repo 之外）
# 可用 ALERTFLOW_SECRETS_FILE=/path/to/file 覆盖。
#
# scripts/create-secrets.sh 的行为：
#   - 文件不存在时创建并自动生成随机 token（hex 48 字符）；
#   - 已存在的值不会覆盖；集群里已有同名 Secret 时会先读回已有值，保证幂等；
#   - 只把 key 名字打印到终端，**从不 echo 值**。
#
# 格式：KEY=VALUE，一行一个，不要引号、不要空格（password/token 都是 hex 或 URL-safe）。
# 必需项（缺失会自动生成）：
POSTGRES_PASSWORD=
AGENT_GRPC_TOKEN=
AGENT_INTERNAL_TOKEN=
AGENT_TASK_GRPC_TOKEN=
AGENT_API_TOKEN=
AGENT_WEBHOOK_TOKEN=
FAULT_LAB_CONTROL_TOKEN=
# 可选（留空则对应能力关闭）：
LLM_API_KEY=
PROMETHEUS_MCP_TOKEN=
LOKI_MCP_TOKEN=
RAGFLOW_API_KEY=
FAULT_LAB_DIAGNOSTICS_TOKEN=
# 非秘密但逐环境不同的值（会写进 ConfigMap 覆盖，不写 Secret）：
LLM_BASE_URL=
LLM_MODEL=
PROMETHEUS_MCP_URL=
LOKI_MCP_URL=
A2A_ADAPTER_URL=
RAGFLOW_BASE_URL=
RAGFLOW_AGENT_ID=
